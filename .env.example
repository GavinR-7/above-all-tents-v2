# API key from your Resend dashboard (https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that new quote requests should be delivered to (Mike's email)
QUOTE_TO_EMAIL=

# Verified "from" address/domain in Resend that quote emails are sent from
QUOTE_FROM_EMAIL=

# Google reCAPTCHA v2 ("I am not a robot" checkbox) keys, from https://www.google.com/recaptcha/admin
# Both optional: if unset the form still works, protected by the honeypot and time trap only.
# Set these in your hosting provider's environment, then rebuild (the site key is read at build time).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
